# Makefile.nmake — build the spiral CA (MSVC via nmake)
#
# Usage:
#   nmake /f Makefile.nmake                # build spiral.exe, test_axis.exe, spiral_3d.exe
#   nmake /f Makefile.nmake test_axis.exe  # build headless test_axis.exe
#   nmake /f Makefile.nmake spiral_3d.exe  # build interactive 3D viewer
#   nmake /f Makefile.nmake spiral_3d_bcast.exe  # build broadcast edition
#   nmake /f Makefile.nmake momentum.exe         # build momentum CA (m = 0)
#   nmake /f Makefile.nmake spiral_auto.exe      # fused: axis elected from w
#   nmake /f Makefile.nmake clean          # remove artefacts

CC     = cl
CFLAGS = /Ox /W3

SDL_INC = /I"E:\vcpkg\installed\x64-windows\include"
SDL_LIB = "E:\vcpkg\installed\x64-windows\lib\SDL3.lib"

all: spiral.exe test_axis.exe spiral_3d.exe spiral_3d_bcast.exe momentum.exe spiral_auto.exe

spiral.exe: spiral.c spiral.h
	$(CC) $(CFLAGS) /Fe:spiral.exe spiral.c $(SDL_INC) $(SDL_LIB)

test_axis.exe: test_axis.c spiral.c spiral.h
	$(CC) $(CFLAGS) /DNO_SDL /Fe:test_axis.exe test_axis.c spiral.c

# Interactive 3D viewer.
# The CA core (spiral.c) must be compiled headless (-DNO_SDL) so its own
# main()/render_frame are excluded, then linked with spiral_3d.c (viewer).
# NOTE: uses spiral_nosdl.obj (not spiral.obj) so it never collides with
# the SDL build of spiral.c used by spiral.exe.
spiral_3d.exe: spiral_3d.obj spiral_nosdl.obj
	$(CC) /Fe:spiral_3d.exe spiral_3d.obj spiral_nosdl.obj $(SDL_LIB)

spiral_3d.obj: spiral_3d.c spiral.h
	$(CC) $(CFLAGS) /c spiral_3d.c $(SDL_INC)

spiral_nosdl.obj: spiral.c spiral.h
	$(CC) $(CFLAGS) /DNO_SDL /c /Fospiral_nosdl.obj spiral.c

# "Grid broadcast" edition of the 3D viewer (spiral_3d_bcast.c):
# every newly computed spiral point is propagated instantaneously to
# all grid cells and shown as a faint, lowest-priority colour dust.
spiral_3d_bcast.exe: spiral_3d_bcast.obj spiral_nosdl.obj
	$(CC) /Fe:spiral_3d_bcast.exe spiral_3d_bcast.obj spiral_nosdl.obj $(SDL_LIB)

spiral_3d_bcast.obj: spiral_3d_bcast.c spiral.h
	$(CC) $(CFLAGS) /c spiral_3d_bcast.c $(SDL_INC)

# Momentum CA: pulsating sphere only, seeded with a NULL momentum
# vector m (self-contained; shares constants/types via spiral.h but
# does NOT link the spiral core).
momentum.exe: momentum.c spiral.h
	$(CC) $(CFLAGS) /Fe:momentum.exe momentum.c $(SDL_INC) $(SDL_LIB)

# Fused automaton: pulsating sphere + w-election of the direction +
# helix walker on the elected axis.  Links the headless spiral core.
spiral_auto.exe: spiral_auto.obj spiral_nosdl.obj
	$(CC) /Fe:spiral_auto.exe spiral_auto.obj spiral_nosdl.obj $(SDL_LIB)

spiral_auto.obj: spiral_auto.c spiral.h
	$(CC) $(CFLAGS) /c spiral_auto.c $(SDL_INC)

clean:
	-del /q *.obj *.exe 2>nul